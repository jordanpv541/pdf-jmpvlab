# Copia este archivo como .env y cambia los valores.

# Dirección de la API (necesita un registro DNS tipo A que apunte a la IP del servidor)
API_DOMAIN=api-pdf.jmpvlab.com

# Páginas que pueden usar la API (separadas por comas)
ALLOWED_ORIGINS=https://pdf.jmpvlab.com
# Dónde está el código fuente (lo exige la licencia AGPL)
SOURCE_URL=https://github.com/jordanpv541/pdf-jmpvlab

# Límites
# Tamaño máximo del archivo (si lo cambias, cambia también max_size en Caddyfile y MAX_UPLOAD_MB en public/assets/js/remote.js)
MAX_UPLOAD_MB=50
# Páginas máximas de un PDF (PDF a Word tiene su propio máximo, más bajo, porque es la conversión más lenta)
MAX_PDF_PAGES=300
MAX_WORD_PAGES=150
# Conversiones al mismo tiempo, y cuántas más pueden esperar turno (o estar subiendo su archivo)
MAX_JOBS=2
MAX_WAITING=8
# Conversiones a la vez de una misma persona (IP)
MAX_PER_IP=2
# Conversiones por persona (IP) en RATE_WINDOW segundos
RATE_LIMIT=30
RATE_WINDOW=600
# Segundos máximos de cada conversión. Gotenberg se corta antes, a los 170 s (--api-timeout en
# docker-compose.yml): si bajas este número, baja también ese, para que siga siendo menor.
JOB_TIMEOUT=180
# Segundos máximos para terminar de subir el archivo
UPLOAD_TIMEOUT=300
# Tamaño máximo del archivo convertido, en MB
MAX_OUTPUT_MB=200
# Memoria máxima de cada conversión de PDF a Word, Excel o PowerPoint, en MB
CHILD_MEMORY_MB=1536
